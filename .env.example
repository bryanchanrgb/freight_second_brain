# Optional API keys. The public MVP runs without these.
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# EIA Open Data APIv2 (bulk ZIP downloads do not need a key)
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# USDA FAS Open Data (bulk PSD ZIP downloads do not need a key)
USDA_API_KEY=

# UN Comtrade subscription key (preview API works without it)
COMTRADE_SUBSCRIPTION_KEY=

# OilPriceAPI token for a licensed BDI proxy
OILPRICE_API_TOKEN=

# LLM provider for the agent runtime (tools work without this)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Override data root (default: ./data)
FREIGHT_SB_DATA_ROOT=
