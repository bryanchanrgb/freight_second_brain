# Optional API keys. The public MVP runs without these.
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# EIA Open Data APIv2 (bulk ZIP downloads do not need a key)
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# USDA FAS Open Data (bulk PSD ZIP downloads do not need a key)
USDA_API_KEY=

# UN Comtrade subscription key (preview API works without it)
COMTRADE_SUBSCRIPTION_KEY=

# OilPriceAPI token for dated BDI/BCI and cargo/energy prices (`market_feed` on the deployable agent).
# Free signup, no credit card: https://www.oilpriceapi.com/auth/signup
# Docs also accept OILPRICEAPI_KEY as the same value.
OILPRICE_API_TOKEN=

# LLM provider for the agent runtime (tools work without this)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Deployable research agent (LangChain + OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Exa web search (optional). Without a key, web_search uses Exa's hosted MCP free tier.
# Set a key to lift rate limits and use the Search REST API.
EXA_API_KEY=

# Override data root (default: ./data)
FREIGHT_SB_DATA_ROOT=

# Desk bind (containers set HOST=0.0.0.0 and honor PORT).
# HOST=127.0.0.1
# PORT=8787

# Public URL gate. Leave empty on localhost. Set a long random token on a
# hosted desk so strangers cannot spend your OpenRouter / OilPriceAPI keys.
DESK_ACCESS_TOKEN=
